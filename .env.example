# Run `make env` (or copy this file to .env) and fill in local secrets.
# Never commit real API keys. Startup hosts and ports are configured through
# Make variables, for example: make dev BACKEND_PORT=8001 FRONTEND_PORT=5174

# OpenAI SDK configuration for KnowAct graph authoring and later LLM-backed agents.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# KnowAct-specific OpenAI defaults. Override per experiment if needed.
KNOWACT_OPENAI_MODEL=gpt-5.5
# Comma-separated allowlist used by Episode registration selectors.
KNOWACT_OPENAI_MODELS=gpt-5.5
KNOWACT_OPENAI_TEMPERATURE=0
KNOWACT_OPENAI_TIMEOUT_SECONDS=120

# DeepSeek OpenAI-compatible chat-completions configuration.
# Select it per API request with client_provider=deepseek.
DEEPSEEK_API_KEY=
KNOWACT_DEEPSEEK_MODEL=deepseek-v4-flash
# Comma-separated allowlist used by Episode registration selectors.
KNOWACT_DEEPSEEK_MODELS=deepseek-v4-flash
KNOWACT_DEEPSEEK_BASE_URL=https://api.deepseek.com
KNOWACT_DEEPSEEK_TIMEOUT_SECONDS=120
