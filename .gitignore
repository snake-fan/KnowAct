# Local source texts stay untracked. The three small authoring metadata files are
# versioned so their scope, reference-grounded question banks, and node budgets
# remain reproducible without committing the books themselves.
storage/*
!storage/.gitkeep
!storage/source_materials/
storage/source_materials/*
!storage/source_materials/Economy/
!storage/source_materials/ISLP/
!storage/source_materials/OSTEP/
