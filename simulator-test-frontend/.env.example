# Empty means same-origin API. For a separately hosted backend, use its public
# origin, for example https://api.example.org (without a trailing slash).
VITE_API_BASE_URL=

# Used only by the local Vite development proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional participant-app presentation defaults.
VITE_STUDY_ID=simulator-personal-fidelity-v1
VITE_STUDY_TITLE=Simulator 个人一致性实验
VITE_SIMULATOR_PROVIDER=openai
VITE_DEFAULT_LANGUAGE=zh-CN
